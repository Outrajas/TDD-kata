generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

enum InventoryMovementType {
  PURCHASE
  RESTOCK
  INITIAL_STOCK
  ADJUSTMENT

  @@map("inventory_movement_type")
}

model User {
  id             String              @id @default(uuid()) @db.Uuid
  email          String              @db.VarChar(320)
  emailNormalized String             @unique @map("email_normalized") @db.VarChar(320)
  passwordHash   String              @map("password_hash") @db.VarChar(255)
  role           Role                @default(CUSTOMER)
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchases      Purchase[]
  movements      InventoryMovement[]

  @@map("users")
}

model Vehicle {
  id        String              @id @default(uuid()) @db.Uuid
  make      String              @db.VarChar(80)
  model     String              @db.VarChar(100)
  category  String              @db.VarChar(40)
  price     Decimal             @db.Decimal(12, 2)
  quantity  Int                 @default(0) @map("stock_quantity")
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchases Purchase[]
  movements InventoryMovement[]

  @@index([make, model])
  @@index([category])
  @@index([price])
  @@index([isActive, quantity])
  @@map("vehicles")
}

model Purchase {
  id                  String            @id @default(uuid()) @db.Uuid
  purchasedByUserId   String            @map("purchased_by_user_id") @db.Uuid
  vehicleId           String            @map("vehicle_id") @db.Uuid
  unitPriceAtPurchase Decimal           @map("unit_price_at_purchase") @db.Decimal(12, 2)
  requestKey          String?           @map("request_key") @db.VarChar(128)
  purchasedAt         DateTime          @default(now()) @map("purchased_at") @db.Timestamptz(6)
  user                User              @relation(fields: [purchasedByUserId], references: [id], onDelete: Restrict)
  vehicle             Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  movement            InventoryMovement?

  @@unique([purchasedByUserId, requestKey])
  @@index([purchasedByUserId, purchasedAt])
  @@index([vehicleId, purchasedAt])
  @@map("purchases")
}

model InventoryMovement {
  id           String                @id @default(uuid()) @db.Uuid
  vehicleId    String                @map("vehicle_id") @db.Uuid
  actorUserId  String                @map("actor_user_id") @db.Uuid
  purchaseId   String?               @unique @map("purchase_id") @db.Uuid
  type         InventoryMovementType
  quantityDelta Int                  @map("quantity_delta")
  quantityAfter Int                  @map("quantity_after")
  note         String?               @db.VarChar(500)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  vehicle      Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  actor        User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  purchase     Purchase?             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([vehicleId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("inventory_movements")
}
