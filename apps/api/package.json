{
  "name": "@dealership/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed:admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@dealership/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "express": "5.1.0",
    "jose": "6.2.13",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "@types/node": "26.6.5",
    "@types/express": "5.0.3",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
